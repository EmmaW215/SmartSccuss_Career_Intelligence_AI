# Phase 4 PR 4-2 — systemd unit for the SmartSuccess GPU server.
# Replaces the ad-hoc start_server.sh: auto-restart, boot-start, journald logs.
#
# Install (on the GPU host):
#   sudo cp deploy/smartsuccess-gpu.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now smartsuccess-gpu
#   journalctl -u smartsuccess-gpu -f      # live logs
#
# Edit User/paths to match the host. Secrets live in the EnvironmentFile
# (see deploy/gpu-server.env.example) — never commit the real file.

[Unit]
Description=SmartSuccess GPU Server (faster-whisper + XTTS + RAG)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smartsuccess
WorkingDirectory=/opt/smartsuccess/gpu-server
EnvironmentFile=/opt/smartsuccess/gpu-server/.env
ExecStart=/opt/smartsuccess/gpu-server/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
# Give the process time to load Whisper + XTTS on startup before health checks.
TimeoutStartSec=300
# GPU access (NVIDIA): the unit inherits the host CUDA env; no extra caps needed
# for a user-mode process with the driver installed.

[Install]
WantedBy=multi-user.target
