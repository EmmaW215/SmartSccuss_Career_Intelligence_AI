# Phase 4 PR 4-2 — GPU server environment (copy to /opt/smartsuccess/gpu-server/.env)
# NEVER commit the real .env. systemd loads this via EnvironmentFile.

# Shared secret required as X-Internal-Token on /api/* and /metrics.
# Generate once:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Paste the SAME value into the Render backend env as INTERNAL_API_TOKEN.
INTERNAL_API_TOKEN=

# Max concurrent GPU inferences (VRAM OOM guard). Default 2.
GPU_CONCURRENCY=2

# faster-whisper compute type override (default: int8_float16 on CUDA / int8 on CPU)
# WHISPER_COMPUTE=int8_float16

# Chroma persist dir for user-doc RAG (optional)
# CHROMA_PERSIST_DIR=/opt/smartsuccess/gpu-server/data/chroma
